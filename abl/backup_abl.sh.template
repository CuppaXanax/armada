# From ROCKNIX (https://github.com/ROCKNIX/abl), (c) ROCKNIX contributors.

set -eu

dir="/sdcard/rocknix_abl/%DEVICE%"
umask 077

for slot in a b; do
	source="/dev/block/by-name/abl_${slot}"
	output="${dir}/abl_${slot}.img"
	[ -r "${source}" ] || { echo "ERROR: cannot read ${source}" >&2; exit 1; }
	[ ! -e "${output}" ] || { echo "ERROR: ${output} already exists; preserve it before retrying" >&2; exit 1; }
	dd if="${source}" of="${output}" bs=1M
	[ -s "${output}" ] || { echo "ERROR: backup is empty: ${output}" >&2; exit 1; }
	sha256sum "${output}" > "${output}.sha256"
done

sync
echo "ABL backups complete. Copy abl_a.img, abl_b.img, and their checksums to another computer before flashing."
