# From ROCKNIX (https://github.com/ROCKNIX/abl), (c) ROCKNIX contributors.

set -eu

dir="/sdcard/rocknix_abl/%DEVICE%"
for slot in a b; do
	backup="${dir}/abl_${slot}.img"
	[ -s "${backup}" ] || { echo "ERROR: backup is missing: ${backup}" >&2; exit 1; }
	(cd "${dir}" && sha256sum -c "abl_${slot}.img.sha256")
done

for slot in a b; do
	target="/dev/block/by-name/abl_${slot}"
	[ -w "${target}" ] || { echo "ERROR: cannot write ${target}" >&2; exit 1; }
done

for slot in a b; do
	target="/dev/block/by-name/abl_${slot}"
	dd if="${dir}/abl_${slot}.img" of="${target}" bs=1M
done

sync
echo "Verified ABL backups restored to both slots."
